# This file is written automatically by the installer wizard -- you
# shouldn't normally need to edit it by hand. Documented here for
# reference/troubleshooting, and for anyone running the bridge manually
# (e.g. `node poll-and-print.js`) without the installer.

# A pair of scoped Azure SAS URLs -- NOT the account's full connection
# string. Generated from Ovenette's admin: /admin/settings/labels ->
# Printers -> Add Printer (or "Regenerate setup credentials"), shown as
# one combined "setup code" you paste into the installer wizard, which
# writes out these two lines verbatim. QUEUE_SAS_URL can only receive
# and delete messages from this printer's own queue (no access to any
# other printer's queue, and it can't add messages either).
# CONTAINER_SAS_URL is read-only access to the print-job-files
# container (can't write, delete, or list -- it only ever fetches a
# specific, already-known blob path).
QUEUE_SAS_URL="changeme"
CONTAINER_SAS_URL="changeme"

# The Ovenette app's own base URL. No trailing slash. Baked into the
# installer at build time (this one value isn't secret, so it's fine to
# ship identically in every install).
OVENETTE_API_BASE_URL="https://ovenettebakehouse.com"

# This printer's own API key, generated alongside the setup code above.
# Used to authenticate the two small Ovenette API calls this bridge
# makes (resolving its own printer id, and fetching each job's blob
# path) -- a separate credential from the Azure SAS pair above, scoped
# to the Ovenette API rather than Azure Storage directly. Typed into the
# installer wizard.
PRINTER_API_KEY="changeme"

# The exact name of the Windows-registered printer this bridge sends
# labels to -- selected from a live dropdown during install (Get-Printer),
# never free-typed, so it always matches exactly.
PRINTER_NAME="DYMO LabelWriter 4XL"

# How often to poll, in milliseconds. Optional.
# POLL_INTERVAL_MS="5000"
