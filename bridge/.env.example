# This file is written automatically by the installer wizard -- you
# shouldn't normally need to edit it by hand. Documented here for
# reference/troubleshooting, and for anyone running the bridge manually
# (e.g. `node poll-and-print.js`) without the installer.

# Same Storage Account connection string the main Ovenette app uses
# (AZURE_STORAGE_CONNECTION_STRING) -- baked into the installer at build
# time, not something you type during setup.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=changeme;AccountKey=changeme;EndpointSuffix=core.windows.net"

# The Ovenette app's own base URL. No trailing slash. Baked into the
# installer at build time.
OVENETTE_API_BASE_URL="https://ovenettebakehouse.com"

# This printer's own API key, generated from
# /admin/settings/labels -> Printers -> Add Printer (or Regenerate API
# key) in the Ovenette admin. Typed into the installer wizard.
PRINTER_API_KEY="changeme"

# The exact name of the Windows-registered printer this bridge sends
# labels to -- selected from a live dropdown during install (Get-Printer),
# never free-typed, so it always matches exactly.
PRINTER_NAME="DYMO LabelWriter 4XL"

# How often to poll, in milliseconds. Optional.
# POLL_INTERVAL_MS="5000"
